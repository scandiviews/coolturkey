# coolturkey — Cloudflare Pages headers
#
# This file deliberately REPLACES the teardown headers that were serving
# X-Robots-Tag: noindex and Clear-Site-Data on every path. Neither appears
# below, and neither should ever come back.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# HTML revalidates every time, so a redeploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS are versioned with ?v= in the markup, so they can be cached hard.
# Bump the version string when they change.
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable

# The old app's service worker must never be cached.
/sw.js
  Cache-Control: no-store
